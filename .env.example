# Application
NODE_ENV=development

# Auth (run: npx auth secret)
AUTH_SECRET=replace-me-with-32+-char-secret
NEXTAUTH_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/realtime-analytics?retryWrites=true&w=majority

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-project.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# CORS / Server
CORS_ORIGIN=http://localhost:3000
PORT=4000

# Next.js public/server
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
SERVER_URL=http://localhost:4000

# Seed data (used by `pnpm seed`)
SEED_ADMIN_EMAIL=admin@realtime.dev
SEED_ADMIN_PASSWORD=admin123456

# Load test
LOADTEST_API_KEY=
LOADTEST_ORG_ID=
